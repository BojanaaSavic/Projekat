  rdfs:comment "Segment length for calculating line section capabilities." ;
  rdfs:domain <http://iec.ch/TC57/CIM100#Conductor> ;
  ns0:dataType <http://iec.ch/TC57/CIM100#Length> ;
  ns0:multiplicity ns0:M:0..1 ;
