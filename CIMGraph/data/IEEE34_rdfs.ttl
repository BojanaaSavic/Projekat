  rdfs:range <http://iec.ch/TC57/CIM100#TransformerEndInfo> ;
  ns0:multiplicity ns0:M:1..n ;
  ns0:inverseRoleName <http://iec.ch/TC57/CIM100#TransformerEndInfo.GroundedEndShortCircuitTests> .

<http://iec.ch/TC57/CIM100#ShortCircuitTest.energisedEndStep>
  a rdf:Property ;
