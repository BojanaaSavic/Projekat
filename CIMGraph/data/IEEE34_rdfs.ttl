  a <http://iec.ch/TC57/CIM100#PhaseCode> ;
  rdfs:label "B" ;
  rdfs:comment "Phase B." ;
  rdfs:subClassOf <http://iec.ch/TC57/CIM100#IdentifiedObject> .

