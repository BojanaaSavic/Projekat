  a <http://iec.ch/TC57/CIM100#PhaseCode> ;
  rdfs:label "AC" ;
  rdfs:comment "Phases A and C." .

<http://iec.ch/TC57/CIM100#PhaseCode.ACN>
  a <http://iec.ch/TC57/CIM100#PhaseCode> ;
  rdfs:label "ACN" ;
  rdfs:comment "Phases A, C and neutral." .

<http://iec.ch/TC57/CIM100#PhaseCode.AN>
  a <http://iec.ch/TC57/CIM100#PhaseCode> ;
  rdfs:label "AN" ;
  rdfs:comment "Phases A and neutral." .

