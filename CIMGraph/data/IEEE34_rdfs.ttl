  a <http://iec.ch/TC57/CIM100#PhaseCode> ;
  rdfs:label "BCN" ;
  rdfs:comment "Phases B, C, and neutral." .

<http://iec.ch/TC57/CIM100#PhaseCode.BN>
  a <http://iec.ch/TC57/CIM100#PhaseCode> ;
  rdfs:label "BN" ;
  rdfs:comment "Phases B and neutral." .

<http://iec.ch/TC57/CIM100#PhaseCode.C>
  a <http://iec.ch/TC57/CIM100#PhaseCode> ;
  rdfs:label "C" ;
  rdfs:comment "Phase C." .

<http://iec.ch/TC57/CIM100#PhaseCode.CN>
  a <http://iec.ch/TC57/CIM100#PhaseCode> ;
  rdfs:label "CN" ;
  rdfs:comment "Phases C and neutral." .

<http://iec.ch/TC57/CIM100#PhaseCode.N>
  a <http://iec.ch/TC57/CIM100#PhaseCode> ;
  rdfs:label "N" ;
