  rdfs:domain <http://iec.ch/TC57/CIM100#RegulatingControl> ;
  ns0:dataType xsd:float ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

