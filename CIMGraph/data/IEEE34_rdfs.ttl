  a rdf:Property ;
  rdfs:label "lineDropR" ;
  rdfs:comment "Line drop compensator resistance setting for normal (forward) power flow." ;
  rdfs:domain <http://iec.ch/TC57/CIM100#TapChangerControl> ;
  ns0:dataType <http://iec.ch/TC57/CIM100#Resistance> ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

<http://iec.ch/TC57/CIM100#TapChangerControl.lineDropX>
  a rdf:Property ;
