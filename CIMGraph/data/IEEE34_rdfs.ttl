  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

<http://iec.ch/TC57/CIM100#ShortCircuitTest.leakageImpedanceZero>
  a rdf:Property ;
  rdfs:label "leakageImpedanceZero" ;
  rdfs:comment "Leakage impedance measured from a zero-sequence short-circuit test." ;
  rdfs:domain <http://iec.ch/TC57/CIM100#ShortCircuitTest> ;
  ns0:dataType <http://iec.ch/TC57/CIM100#Impedance> ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

<http://iec.ch/TC57/CIM100#ShortCircuitTest.loss>
  a rdf:Property ;
  rdfs:label "loss" ;
  rdfs:comment "Load losses from a positive-sequence or single-phase short-circuit test." ;
