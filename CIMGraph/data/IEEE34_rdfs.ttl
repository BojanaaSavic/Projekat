  a rdf:Property ;
  rdfs:label "TapChangerControl" ;
  rdfs:comment "The regulating control scheme in which this tap changer participates." ;
  rdfs:domain <http://iec.ch/TC57/CIM100#TapChanger> ;
  rdfs:range <http://iec.ch/TC57/CIM100#TapChangerControl> ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:inverseRoleName <http://iec.ch/TC57/CIM100#TapChangerControl.TapChanger> .

<http://iec.ch/TC57/CIM100#TapChanger.controlEnabled>
  a rdf:Property ;
  rdfs:label "controlEnabled" ;
  rdfs:comment "Specifies the regulation status of the equipment.  True is regulating, false is not regulating." ;
  rdfs:domain <http://iec.ch/TC57/CIM100#TapChanger> ;
  ns0:dataType xsd:boolean ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

<http://iec.ch/TC57/CIM100#TapChanger.highStep>
  a rdf:Property ;
  rdfs:label "highStep" ;
  rdfs:comment """Highest possible tap step position, advance from neutral.
The attribute shall be greater than lowStep.""" ;
  rdfs:domain <http://iec.ch/TC57/CIM100#TapChanger> ;
  ns0:dataType xsd:integer ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

<http://iec.ch/TC57/CIM100#TapChanger.initialDelay>
  a rdf:Property ;
  rdfs:label "initialDelay" ;
  rdfs:comment "For an LTC, the delay for initial tap changer operation (first step change)." ;
  rdfs:domain <http://iec.ch/TC57/CIM100#TapChanger> ;
  ns0:dataType <http://iec.ch/TC57/CIM100#Seconds> ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

<http://iec.ch/TC57/CIM100#TapChanger.lowStep>
  a rdf:Property ;
  rdfs:label "lowStep" ;
  rdfs:comment "Lowest possible tap step position, retard from neutral." ;
  rdfs:domain <http://iec.ch/TC57/CIM100#TapChanger> ;
  ns0:dataType xsd:integer ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

<http://iec.ch/TC57/CIM100#TapChanger.ltcFlag>
  a rdf:Property ;
  rdfs:label "ltcFlag" ;
  rdfs:comment "Specifies whether or not a TapChanger has load tap changing capabilities." ;
  rdfs:domain <http://iec.ch/TC57/CIM100#TapChanger> ;
  ns0:dataType xsd:boolean ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

<http://iec.ch/TC57/CIM100#TapChanger.neutralStep>
  a rdf:Property ;
  rdfs:label "neutralStep" ;
  rdfs:comment """The neutral tap step position for this winding.
The attribute shall be equal to or greater than lowStep and equal or less than highStep.
It is the step position where the voltage is neutralU when the other terminals of the transformer are at the ratedU.  If there are other tap changers on the transformer those taps are kept constant at their neutralStep.""" ;
  rdfs:domain <http://iec.ch/TC57/CIM100#TapChanger> ;
  ns0:dataType xsd:integer ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

<http://iec.ch/TC57/CIM100#TapChanger.neutralU>
  a rdf:Property ;
  rdfs:label "neutralU" ;
  rdfs:comment """Voltage at which the winding operates at the neutral tap setting. It is the voltage at the terminal of the PowerTransformerEnd associated with the tap changer when all tap changers on the transformer are at their neutralStep position.  Normally neutralU of the tap changer is the same as ratedU of the PowerTransformerEnd, but it can differ in special cases such as when the tapping mechanism is separate from the winding more common on lower voltage transformers.
This attribute is not relevant for PhaseTapChangerAsymmetrical, PhaseTapChangerSymmetrical and PhaseTapChangerLinear.""" ;
  rdfs:domain <http://iec.ch/TC57/CIM100#TapChanger> ;
  ns0:dataType <http://iec.ch/TC57/CIM100#Voltage> ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

<http://iec.ch/TC57/CIM100#TapChanger.normalStep>
  a rdf:Property ;
  rdfs:label "normalStep" ;
  rdfs:comment """The tap step position used in "normal" network operation for this winding. For a "Fixed" tap changer indicates the current physical tap setting.
The attribute shall be equal to or greater than lowStep and equal to or less than highStep.""" ;
  rdfs:domain <http://iec.ch/TC57/CIM100#TapChanger> ;
  ns0:dataType xsd:integer ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

<http://iec.ch/TC57/CIM100#TapChanger.step>
  a rdf:Property ;
  rdfs:label "step" ;
  rdfs:comment """Tap changer position.
Starting step for a steady state solution. Non integer values are allowed to support continuous tap variables. The reasons for continuous value are to support study cases where no discrete tap changer has yet been designed, a solution where a narrow voltage band forces the tap step to oscillate or to accommodate for a continuous solution as input.
The attribute shall be equal to or greater than lowStep and equal to or less than highStep.""" ;
  rdfs:domain <http://iec.ch/TC57/CIM100#TapChanger> ;
  ns0:dataType xsd:float ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

<http://iec.ch/TC57/CIM100#TapChanger.subsequentDelay>
  a rdf:Property ;
  rdfs:label "subsequentDelay" ;
  rdfs:comment "For an LTC, the delay for subsequent tap changer operation (second and later step changes)." ;
  rdfs:domain <http://iec.ch/TC57/CIM100#TapChanger> ;
  ns0:dataType <http://iec.ch/TC57/CIM100#Seconds> ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

