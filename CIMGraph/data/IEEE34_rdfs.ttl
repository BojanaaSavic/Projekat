  a rdf:Property ;
  rdfs:label "groundedEndStep" ;
  rdfs:comment "Tap step number for the grounded end of the test pair." ;
  rdfs:domain <http://iec.ch/TC57/CIM100#ShortCircuitTest> ;
  ns0:dataType xsd:integer ;
  ns0:multiplicity ns0:M:0..1 ;
  ns0:stereotype <http://langdale.com.au/2005/UML#attribute> .

<http://iec.ch/TC57/CIM100#ShortCircuitTest.leakageImpedance>
  a rdf:Property ;
  rdfs:label "leakageImpedance" ;
  rdfs:comment "Leakage impedance measured from a positive-sequence or single-phase short-circuit test." ;
  rdfs:domain <http://iec.ch/TC57/CIM100#ShortCircuitTest> ;
