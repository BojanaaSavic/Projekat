  owl:inverseOf <http://iec.ch/TC57/CIM100#PhaseTapChangerTablePoint.PhaseTapChangerTable> .

<http://iec.ch/TC57/CIM100#PhaseTapChangerTable.PhaseTapChangerTabular>
  a owl:ObjectProperty ;
  rdfs:label "PhaseTapChangerTabular"@en ;
