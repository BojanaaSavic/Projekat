  rdfs:range <http://iec.ch/TC57/CIM100#ReactivePower> ;
  skos:definition "Maximum reactive power limit. This is the maximum (nameplate) limit for the unit."@en .

<http://iec.ch/TC57/CIM100#PowerElectronicsConnection.minQ>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "minQ"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#PowerElectronicsConnection> ;
  rdfs:range <http://iec.ch/TC57/CIM100#ReactivePower> ;
  skos:definition "Minimum reactive power limit for the unit. This is the minimum (nameplate) limit for the unit."@en .

<http://iec.ch/TC57/CIM100#PowerElectronicsConnection.ratedS>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "ratedS"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#PowerElectronicsConnection> ;
  rdfs:range <http://iec.ch/TC57/CIM100#ApparentPower> ;
  skos:definition """
Nameplate apparent power rating for the unit.
The attribute shall have a positive value.
	"""@en .

<http://iec.ch/TC57/CIM100#PowerElectronicsConnection.ratedU>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "ratedU"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#PowerElectronicsConnection> ;
  rdfs:range <http://iec.ch/TC57/CIM100#Voltage> ;
