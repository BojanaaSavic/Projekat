  a owl:Thing, owl:NamedIndividual ;
  skos:definition "Indicates the synchronous machine can operate as a generator or as a motor."@en ;
  ns0:isenum "True" ;
  rdfs:label "generatorOrMotor "@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#SynchronousMachineKind> .

