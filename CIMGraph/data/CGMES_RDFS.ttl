  skos:definition """
Exponent of per unit frequency effecting active power.

	"""@en .

<http://iec.ch/TC57/CIM100#LoadResponseCharacteristic.pVoltageExponent>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "pVoltageExponent"@en ;
