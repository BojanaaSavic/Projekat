  owl:inverseOf <http://iec.ch/TC57/CIM100#RatioTapChangerTable.RatioTapChangerTablePoint> .

<http://iec.ch/TC57/CIM100#RatioTapChangerTablePoint>
  rdfs:label "RatioTapChangerTablePoint"@en ;
  a owl:Class ;
