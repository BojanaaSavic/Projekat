  rdfs:subClassOf <http://iec.ch/TC57/CIM100#IdentifiedObject> ;
  skos:definition "The fossil fuel consumed by the non-nuclear thermal generating unit.   For example, coal, oil, gas, etc.   These are the specific fuels that the generating unit can consume."@en ;
  ns0:Package "Package_CoreEquipmentProfile" .

<http://iec.ch/TC57/CIM100#FossilFuel.fossilFuelType>
