  rdfs:label "b"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#PowerTransformerEnd> ;
  rdfs:range <http://iec.ch/TC57/CIM100#Susceptance> ;
  skos:definition """
Magnetizing branch susceptance (B mag).  The value can be positive or negative.

	"""@en .

<http://iec.ch/TC57/CIM100#PowerTransformerEnd.connectionKind>
