<http://iec.ch/TC57/CIM100#PhaseTapChangerTable.PhaseTapChangerTablePoint>
  a owl:ObjectProperty ;
  rdfs:label "PhaseTapChangerTablePoint"@en ;
  skos:definition "The points of this table."@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#PhaseTapChangerTable> ;
