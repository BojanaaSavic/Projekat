<http://iec.ch/TC57/CIM100#ReactiveCapabilityCurve.InitiallyUsedBySynchronousMachines>
  a owl:ObjectProperty ;
  rdfs:label "InitiallyUsedBySynchronousMachines"@en ;
  skos:definition "Synchronous machines using this curve as default."@en ;
