  rdfs:range <http://iec.ch/TC57/CIM100#ThermalGeneratingUnit> ;
  owl:inverseOf <http://iec.ch/TC57/CIM100#ThermalGeneratingUnit.FossilFuels> .

<http://iec.ch/TC57/CIM100#Fuse>
  rdfs:label "Fuse"@en ;
  a owl:Class ;
  rdfs:subClassOf <http://iec.ch/TC57/CIM100#Switch> ;
  skos:definition "An overcurrent protective device with a circuit opening fusible part that is heated and severed by the passage of overcurrent through it. A fuse is considered a switching device because it breaks current."@en ;
  ns0:Package "Package_CoreEquipmentProfile" .

<http://iec.ch/TC57/CIM100#GeneratingUnit>
  rdfs:label "GeneratingUnit"@en ;
  a owl:Class ;
  rdfs:subClassOf <http://iec.ch/TC57/CIM100#Equipment> ;
  skos:definition "A single or set of synchronous machines for converting mechanical power into alternating-current power. For example, individual machines within a set may be defined for scheduling purposes while a single control signal is derived for the set. In this case there would be a GeneratingUnit for each member of the set and an additional GeneratingUnit corresponding to the set."@en ;
  ns0:Package "Package_CoreEquipmentProfile" .

<http://iec.ch/TC57/CIM100#GeneratingUnit.genControlSource>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "genControlSource"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratingUnit> ;
  rdfs:range <http://iec.ch/TC57/CIM100#GeneratorControlSource> ;
  skos:definition "The source of controls for a generating unit.  Defines the control status of the generating unit."@en .

<http://iec.ch/TC57/CIM100#GeneratorControlSource>
  rdfs:label "GeneratorControlSource"@en ;
  a owl:Class ;
  skos:definition """
The source of controls for a generating unit.

	"""@en ;
  ns0:Package "Package_CoreEquipmentProfile" ;
  rdfs:subClassOf <http://iec.ch/TC57/CIM100#Enumeration> ;
  owl:oneOf (
   <http://iec.ch/TC57/CIM100#GeneratorControlSource.unavailable>
   <http://iec.ch/TC57/CIM100#GeneratorControlSource.offAGC>
   <http://iec.ch/TC57/CIM100#GeneratorControlSource.onAGC>
   <http://iec.ch/TC57/CIM100#GeneratorControlSource.plantControl>
 ) .

<http://iec.ch/TC57/CIM100#GeneratorControlSource.unavailable>
  a owl:Thing, owl:NamedIndividual ;
  skos:definition """
Not available.

	"""@en ;
  ns0:isenum "True" ;
  rdfs:label "unavailable "@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratorControlSource> .

<http://iec.ch/TC57/CIM100#GeneratorControlSource.offAGC>
  a owl:Thing, owl:NamedIndividual ;
  skos:definition """
Off of automatic generation control (AGC).

	"""@en ;
  ns0:isenum "True" ;
  rdfs:label "offAGC "@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratorControlSource> .

<http://iec.ch/TC57/CIM100#GeneratorControlSource.onAGC>
  a owl:Thing, owl:NamedIndividual ;
  skos:definition """
On automatic generation control (AGC).

	"""@en ;
  ns0:isenum "True" ;
  rdfs:label "onAGC "@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratorControlSource> .

<http://iec.ch/TC57/CIM100#GeneratorControlSource.plantControl>
  a owl:Thing, owl:NamedIndividual ;
  skos:definition """
Plant is controlling.

	"""@en ;
  ns0:isenum "True" ;
  rdfs:label "plantControl "@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratorControlSource> .

<http://iec.ch/TC57/CIM100#GeneratingUnit.governorSCD>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "governorSCD"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratingUnit> ;
  rdfs:range <http://iec.ch/TC57/CIM100#PerCent> ;
  skos:definition "Governor Speed Changer Droop.   This is the change in generator power output divided by the change in frequency normalized by the nominal power of the generator and the nominal frequency and expressed in percent and negated. A positive value of speed change droop provides additional generator output upon a drop in frequency."@en .

<http://iec.ch/TC57/CIM100#GeneratingUnit.longPF>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "longPF"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratingUnit> ;
  rdfs:range xsd:float ;
  skos:definition """
Generating unit long term economic participation factor.

	"""@en .

<http://iec.ch/TC57/CIM100#GeneratingUnit.maximumAllowableSpinningReserve>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "maximumAllowableSpinningReserve"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratingUnit> ;
  rdfs:range <http://iec.ch/TC57/CIM100#ActivePower> ;
  skos:definition "Maximum allowable spinning reserve. Spinning reserve will never be considered greater than this value regardless of the current operating point."@en .

<http://iec.ch/TC57/CIM100#GeneratingUnit.maxOperatingP>
  a owl:DatatypeProperty ;
  rdfs:label "maxOperatingP"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratingUnit> ;
  rdfs:range <http://iec.ch/TC57/CIM100#ActivePower> ;
  skos:definition """
This is the maximum operating active power limit the dispatcher can enter for this unit.

	"""@en .

<http://iec.ch/TC57/CIM100#GeneratingUnit.minOperatingP>
  a owl:DatatypeProperty ;
  rdfs:label "minOperatingP"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratingUnit> ;
  rdfs:range <http://iec.ch/TC57/CIM100#ActivePower> ;
  skos:definition "This is the minimum operating active power limit the dispatcher can enter for this unit."@en .

<http://iec.ch/TC57/CIM100#GeneratingUnit.nominalP>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "nominalP"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratingUnit> ;
  rdfs:range <http://iec.ch/TC57/CIM100#ActivePower> ;
  skos:definition """
The nominal power of the generating unit.  Used to give precise meaning to percentage based attributes such as the governor speed change droop (governorSCD attribute).
The attribute shall be a positive value equal to or less than RotatingMachine.ratedS.
	"""@en .

<http://iec.ch/TC57/CIM100#GeneratingUnit.ratedGrossMaxP>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "ratedGrossMaxP"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratingUnit> ;
  rdfs:range <http://iec.ch/TC57/CIM100#ActivePower> ;
  skos:definition """
The unit's gross rated maximum capacity (book value).
The attribute shall be a positive value.

	"""@en .

<http://iec.ch/TC57/CIM100#GeneratingUnit.ratedGrossMinP>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "ratedGrossMinP"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratingUnit> ;
  rdfs:range <http://iec.ch/TC57/CIM100#ActivePower> ;
  skos:definition """
The gross rated minimum generation level which the unit can safely operate at while delivering power to the transmission grid.
The attribute shall be a positive value.

	"""@en .

<http://iec.ch/TC57/CIM100#GeneratingUnit.ratedNetMaxP>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "ratedNetMaxP"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratingUnit> ;
  rdfs:range <http://iec.ch/TC57/CIM100#ActivePower> ;
  skos:definition """
The net rated maximum capacity determined by subtracting the auxiliary power used to operate the internal plant machinery from the rated gross maximum capacity.
The attribute shall be a positive value.

	"""@en .

<http://iec.ch/TC57/CIM100#GeneratingUnit.shortPF>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "shortPF"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratingUnit> ;
  rdfs:range xsd:float ;
  skos:definition """
Generating unit short term economic participation factor.

	"""@en .

<http://iec.ch/TC57/CIM100#GeneratingUnit.startupCost>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "startupCost"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#GeneratingUnit> ;
  rdfs:range <http://iec.ch/TC57/CIM100#Money> ;
