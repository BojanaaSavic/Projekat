  rdfs:domain <http://iec.ch/TC57/CIM100#LoadResponseCharacteristic> ;
  rdfs:range xsd:float ;
  skos:definition "Portion of reactive power load modelled as constant current."@en .

<http://iec.ch/TC57/CIM100#LoadResponseCharacteristic.qConstantImpedance>
