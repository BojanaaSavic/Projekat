  rdfs:range <http://iec.ch/TC57/CIM100#ActivePower> ;
  skos:definition "Minimum active power limit. This is the minimum (nameplate) limit for the unit."@en .

<http://iec.ch/TC57/CIM100#PowerElectronicsWindUnit>
