  owl:inverseOf <http://iec.ch/TC57/CIM100#PhaseTapChangerTabular.PhaseTapChangerTable> .

<http://iec.ch/TC57/CIM100#PhaseTapChangerTabular.PhaseTapChangerTable>
  a owl:ObjectProperty ;
  rdfs:label "PhaseTapChangerTable"@en ;
  skos:definition "The phase tap changer table for this phase tap changer."@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#PhaseTapChangerTabular> ;
  rdfs:range <http://iec.ch/TC57/CIM100#PhaseTapChangerTable> ;
  owl:inverseOf <http://iec.ch/TC57/CIM100#PhaseTapChangerTable.PhaseTapChangerTabular> .

<http://iec.ch/TC57/CIM100#PhaseTapChangerTablePoint>
  rdfs:label "PhaseTapChangerTablePoint"@en ;
  a owl:Class ;
  rdfs:subClassOf <http://iec.ch/TC57/CIM100#TapChangerTablePoint> ;
