  rdfs:subClassOf <http://iec.ch/TC57/CIM100#PhaseTapChanger> ;
  skos:definition "Describes a tap changer with a table defining the relation between the tap step and the phase angle difference across the transformer. "@en ;
  ns0:Package "Package_CoreEquipmentProfile" .

