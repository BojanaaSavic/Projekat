  rdfs:range <http://iec.ch/TC57/CIM100#FossilFuel> ;
  owl:inverseOf <http://iec.ch/TC57/CIM100#FossilFuel.ThermalGeneratingUnit> .

<http://iec.ch/TC57/CIM100#FossilFuel.ThermalGeneratingUnit>
  a owl:ObjectProperty ;
  rdfs:label "ThermalGeneratingUnit"@en ;
  skos:definition "A thermal generating unit may have one or more fossil fuels."@en ;
