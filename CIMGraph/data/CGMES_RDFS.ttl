  rdfs:label "maximumSections"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#ShuntCompensator> ;
  rdfs:range xsd:integer ;
  skos:definition """
The maximum number of sections that may be switched in. 

	"""@en .

<http://iec.ch/TC57/CIM100#ShuntCompensator.nomU>
  a owl:DatatypeProperty ;
  rdfs:label "nomU"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#ShuntCompensator> ;
  rdfs:range <http://iec.ch/TC57/CIM100#Voltage> ;
