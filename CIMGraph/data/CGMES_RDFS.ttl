ns0:Package_CoreEquipmentProfile
  a ns0:Package ;
  rdfs:comment """
This is the IEC 61970-452 core equipment profile.

	"""@en .

<http://iec.ch/TC57/CIM100#ACDCConverter>
  rdfs:label "ACDCConverter"@en ;
  a owl:Class ;
  rdfs:subClassOf <http://iec.ch/TC57/CIM100#ConductingEquipment> ;
  skos:definition "A unit with valves for three phases, together with unit control equipment, essential protective and switching devices, DC storage capacitors, phase reactors and auxiliaries, if any, used for conversion."@en ;
  ns0:Package "Package_CoreEquipmentProfile" ;
  ns0:isAbstract "True" .

<http://iec.ch/TC57/CIM100#ACDCConverter.baseS>
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "baseS"@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#ACDCConverter> ;
  rdfs:range <http://iec.ch/TC57/CIM100#ApparentPower> ;
  skos:definition "Base apparent power of the converter pole. The attribute shall be a positive value."@en .

<http://iec.ch/TC57/CIM100#ApparentPower>
  rdfs:label "ApparentPower"@en ;
  a owl:Class ;
  skos:definition """
Product of the RMS value of the voltage and the RMS value of the current.

	"""@en ;
  ns0:isCIMDatatype "True" ;
  ns0:Package "Package_CoreEquipmentProfile" .

<http://iec.ch/TC57/CIM100#ApparentPower.value>
