  rdfs:domain <http://iec.ch/TC57/CIM100#ACDCConverterDCTerminal> ;
  rdfs:range <http://iec.ch/TC57/CIM100#DCPolarityKind> ;
  skos:definition """
Represents the normal network polarity condition. Depending on the converter configuration the value shall be set as follows:
- For a monopole with two converter terminals use DCPolarityKind “positive” and “negative”.
- For a bi-pole or symmetric monopole with three converter terminals use DCPolarityKind “positive”, “middle” and “negative”.
	"""@en .

<http://iec.ch/TC57/CIM100#DCPolarityKind>
  rdfs:label "DCPolarityKind"@en ;
  a owl:Class ;
  skos:definition "Polarity for DC circuits."@en ;
  ns0:Package "Package_CoreEquipmentProfile" ;
  rdfs:subClassOf <http://iec.ch/TC57/CIM100#Enumeration> ;
  owl:oneOf (
   <http://iec.ch/TC57/CIM100#DCPolarityKind.positive>
   <http://iec.ch/TC57/CIM100#DCPolarityKind.middle>
   <http://iec.ch/TC57/CIM100#DCPolarityKind.negative>
 ) .

<http://iec.ch/TC57/CIM100#DCPolarityKind.positive>
  a owl:Thing, owl:NamedIndividual ;
  skos:definition "Positive pole. The converter terminal is intended to operate at a positive voltage relative the midpoint or negative terminal."@en ;
  ns0:isenum "True" ;
  rdfs:label "positive "@en ;
  rdfs:domain <http://iec.ch/TC57/CIM100#DCPolarityKind> .

<http://iec.ch/TC57/CIM100#DCPolarityKind.middle>
  a owl:Thing, owl:NamedIndividual ;
  skos:definition "Middle pole. The converter terminal is the midpoint in a bipolar or symmetric monopole configuration. The midpoint can be grounded and/or have a metallic return."@en ;
  ns0:isenum "True" ;
